## application-default.yml.example
## 로컬 개발 환경 설정 템플릿
##
## 사용법:
##   cp application-default.yml.example application-default.yml
##   application-default.yml 파일에 실제 값을 채워넣으세요.
##
## 주의: application-default.yml은 .gitignore에 등록되어 있습니다.
##       절대로 실제 시크릿 값을 커밋하지 마세요.

server:
  port: 8080

spring:
  r2dbc:
    url: r2dbc:pool:postgres://<DB_HOST>:<DB_PORT>/dev-docuhelper
    username: postgres
    password: <DB_PASSWD>
  security:
    jwt:
      secret: <JWT_SECRET>
  kafka:
    bootstrap-servers: <KAFKA_HOST>:9092
    consumer:
      auto-offset-reset: latest
  data:
    redis:
      host: <REDIS_HOST>
      port: 6379
      password: <REDIS_PASSWORD>
  ai:
    ollama:
      base-url: <OLLAMA_BASE_URL>
    openai:
      api-key: <OPENAI_API_KEY>

elasticsearch:
  host: <ELASTICSEARCH_HOST>
  port: 9200
  api-key: <ELASTICSEARCH_API_KEY>

docuhelper:
  file:
    endpoint: <DOCUHELPER_FILE_ENDPOINT>

logging:
  level:
    org.apache.kafka: off
#    org.springframework.jdbc.core: DEBUG
#    org.springframework.r2dbc: DEBUG
#    io.r2dbc.postgresql.PARAM: DEBUG

dev:
  default:
    login:
      enable: true
